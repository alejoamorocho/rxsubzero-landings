{% doc %}
  Render the RX SUBZERO health landing and its accessible purchase dialogs.
  Generated by scripts/build-shopify.cjs; edit the reviewed static source.

  @param {object} rxsz_product - Selected live Shopify product, or blank.
  @param {object} rxsz_selected_variant - First available purchase variant.
  @param {object} beauty_page - Beauty landing page.
  @param {object} health_page - Wellness landing page.
  @param {string} section_id - Unique parent section ID.
{% enddoc %}
<a class="rxsz-skip" href="#main" data-i18n="access.skip">{{ 'rxsz.health.access_skip' | t | escape }}</a>

  <header class="rxsz-nav" data-nav="">
    <div class="rxsz-wrap rxsz-nav__bar">
      <a class="rxsz-nav__logo" href="#top" aria-label="RX SUBZERO">
        <img src="{{ 'rxsz-logo-official.png' | asset_url }}" width="1080" height="648" alt="RX SUBZERO">
      </a>
      <nav class="rxsz-nav__links" aria-label="{{ 'rxsz.health.nav_aria' | t | escape }}" data-i18n-attr="aria-label:nav.aria">
        <a href="#ritual" data-i18n="nav.ritual">{{ 'rxsz.health.nav_ritual' | t | escape }}</a>
        <a href="#product" data-i18n="nav.product">{{ 'rxsz.health.nav_product' | t | escape }}</a>
        <a href="#faq" data-i18n="nav.faq">{{ 'rxsz.health.nav_faq' | t | escape }}</a>
      </nav>
      <div class="rxsz-nav__actions">
        <div class="rxsz-langtoggle" role="group" aria-label="{{ 'rxsz.health.nav_language' | t | escape }}">
  {% for language in localization.available_languages %}
    {% if language.iso_code == 'en' or language.iso_code == 'es' %}
      {% assign rxsz_locale_form_id = 'RXSZLanguage-' | append: section_id | append: '-' | append: language.iso_code %}
      {% form 'localization', id: rxsz_locale_form_id, class: 'rxsz-localization', return_to: request.path %}
        <input type="hidden" name="language_code" value="{{ language.iso_code | escape }}">
        <button class="rxsz-langtoggle__opt{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}" type="submit" lang="{{ language.iso_code | escape }}" aria-label="{{ language.endonym_name | escape }}" aria-pressed="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}">{{ language.iso_code | upcase | escape }}</button>
      {% endform %}
    {% endif %}
  {% endfor %}
</div><span class="rxsz-language-status" data-language-status="" role="status" aria-live="polite"></span>
        <a class="rxsz-btn rxsz-nav__cta" href="#offer" data-purchase-action="scroll" data-i18n="nav.cta">{{ 'rxsz.health.nav_cta' | t | escape }}</a>
        <button type="button" class="rxsz-nav__cart" data-cart-open hidden aria-label="{{ 'rxsz.health.commerce_view_cart' | t | escape }}" data-i18n-attr="aria-label:commerce.view_cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h2l2 12h12l2-8H6M9 20h.01M18 20h.01"/></svg><span data-cart-count aria-hidden="true">0</span></button>
        <button class="rxsz-nav__toggle" type="button" data-nav-toggle="" aria-expanded="false" aria-controls="mobile-menu" aria-label="{{ 'rxsz.health.nav_menu' | t | escape }}" data-i18n-attr="aria-label:nav.menu">
          <span class="rxsz-nav__menuicon" aria-hidden="true"></span>
        </button>
      </div>
    </div><nav class="rxsz-paths" aria-label="RX SUBZERO"><div class="rxsz-wrap rxsz-paths__inner">{% if beauty_page != blank %}<a href="{{ beauty_page.url | escape }}" data-i18n="nav.beauty">{{ 'rxsz.health.nav_beauty' | t | escape }}</a>{% endif %}{% if health_page != blank %}<a href="{{ health_page.url | escape }}" data-i18n="nav.health" aria-current="page">{{ 'rxsz.health.nav_health' | t | escape }}</a>{% endif %}</div></nav>
    <div class="rxsz-nav__drawer" id="mobile-menu" data-nav-drawer="">
      <nav class="rxsz-wrap rxsz-nav__drawer-links" aria-label="{{ 'rxsz.health.nav_mobile_aria' | t | escape }}" data-i18n-attr="aria-label:nav.mobile_aria">
        <a href="#ritual" data-i18n="nav.ritual">{{ 'rxsz.health.nav_ritual' | t | escape }}</a>
        <a href="#product" data-i18n="nav.product">{{ 'rxsz.health.nav_product' | t | escape }}</a>
        <a href="#faq" data-i18n="nav.faq">{{ 'rxsz.health.nav_faq' | t | escape }}</a>
        <a class="rxsz-btn rxsz-btn--ghost" href="#offer" data-purchase-action="scroll" data-i18n="nav.cta">{{ 'rxsz.health.nav_cta' | t | escape }}</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="rxsz-auth-hero" id="top"><div class="rxsz-wrap rxsz-auth-hero__layout"><div class="rxsz-auth-hero__content">
          <p class="rxsz-auth-kicker rxsz-hero-animate" data-i18n="hero.kicker">{{ 'rxsz.health.hero_kicker' | t | escape }}</p>
          <h1 class="rxsz-hero-animate">
            <span data-i18n="hero.title_1">{{ 'rxsz.health.hero_title_1' | t | escape }}</span>
            <span data-i18n="hero.title_2">{{ 'rxsz.health.hero_title_2' | t | escape }}</span>
          </h1>
          <p class="rxsz-auth-hero__sub rxsz-hero-animate" data-i18n="hero.sub">{{ 'rxsz.health.hero_sub' | t | escape }}</p>
          <div class="rxsz-auth-hero__actions rxsz-hero-animate">
            <a class="rxsz-btn rxsz-btn--primary" href="#offer" data-purchase-action="scroll" data-i18n="hero.cta_primary">{{ 'rxsz.health.hero_cta_primary' | t | escape }}</a>
            <a class="rxsz-btn rxsz-btn--ghost" href="#ritual" data-i18n="hero.cta_secondary">{{ 'rxsz.health.hero_cta_secondary' | t | escape }}</a>
          </div>
          <p class="rxsz-reference-price">
            <span data-reference-price="">{% if rxsz_product != blank %}{{ rxsz_selected_variant.price | money_with_currency }}{% else %}{{ 'rxsz.shared.price_unavailable' | t | escape }}{% endif %}</span>
            <span hidden=""></span>
          </p>
          <ul class="rxsz-auth-hero__facts rxsz-hero-animate">
            <li><span class="rxsz-ico" data-icon="fold"></span><span data-i18n="hero.fact_1">{{ 'rxsz.health.hero_fact_1' | t | escape }}</span></li>
            <li><span class="rxsz-ico" data-icon="breathe"></span><span data-i18n="hero.fact_2">{{ 'rxsz.health.hero_fact_2' | t | escape }}</span></li>
            <li><span class="rxsz-ico" data-icon="face"></span><span data-i18n="hero.fact_3">{{ 'rxsz.health.hero_fact_3' | t | escape }}</span></li>
          </ul>
        </div><div class="rxsz-auth-hero__media rxsz-explorer" data-explorer role="region" aria-label="{{ 'rxsz.health.explorer_aria' | t | escape }}" data-i18n-attr="aria-label:explorer.aria">
          <div class="rxsz-explorer__stage" data-explorer-stage role="group" tabindex="-1" aria-label="{{ 'rxsz.health.explorer_stage_aria' | t | escape }}" data-i18n-attr="aria-label:explorer.stage_aria">
            <figure class="rxsz-explorer__slide" data-explorer-slide id="health-view-0">
              <img src="{{ 'rxsz-health-hero-life-1200.webp' | asset_url }}" srcset="{{ 'rxsz-health-hero-life-600.webp' | asset_url }} 600w, {{ 'rxsz-health-hero-life-1200.webp' | asset_url }} 1200w" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1320px) 44vw, 584px" width="1200" height="1000" alt="{{ 'rxsz.health.explorer_views_0_alt' | t | escape }}" data-i18n-attr="alt:explorer.views.0.alt" decoding="async" draggable="false" fetchpriority="high">
              <figcaption class="rxsz-explorer__caption" data-explorer-caption data-i18n="explorer.views.0.caption">{{ 'rxsz.health.explorer_views_0_caption' | t | escape }}</figcaption>
            </figure>
            <figure class="rxsz-explorer__slide" data-explorer-slide id="health-view-1" hidden inert>
              <img src="{{ 'rxsz-health-hero-editorial-1120.webp' | asset_url }}" srcset="{{ 'rxsz-health-hero-editorial-600.webp' | asset_url }} 600w, {{ 'rxsz-health-hero-editorial-1120.webp' | asset_url }} 1120w" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1320px) 44vw, 584px" width="1120" height="1400" alt="{{ 'rxsz.health.explorer_views_1_alt' | t | escape }}" data-i18n-attr="alt:explorer.views.1.alt" decoding="async" draggable="false" loading="lazy">
              <figcaption class="rxsz-explorer__caption" data-explorer-caption data-i18n="explorer.views.1.caption">{{ 'rxsz.health.explorer_views_1_caption' | t | escape }}</figcaption>
            </figure>
            <figure class="rxsz-explorer__slide" data-explorer-slide id="health-view-2" hidden inert>
              <img src="{{ 'rxsz-health-ritual-prepare-authentic.webp' | asset_url }}" width="1200" height="1000" alt="{{ 'rxsz.health.explorer_views_2_alt' | t | escape }}" data-i18n-attr="alt:explorer.views.2.alt" decoding="async" draggable="false" loading="lazy">
              <figcaption class="rxsz-explorer__caption" data-explorer-caption data-i18n="explorer.views.2.caption">{{ 'rxsz.health.explorer_views_2_caption' | t | escape }}</figcaption>
            </figure>
            <figure class="rxsz-explorer__slide" data-explorer-slide id="health-view-3" hidden inert>
              <img src="{{ 'rxsz-health-ritual-store-authentic.webp' | asset_url }}" width="1200" height="1000" alt="{{ 'rxsz.health.explorer_views_3_alt' | t | escape }}" data-i18n-attr="alt:explorer.views.3.alt" decoding="async" draggable="false" loading="lazy">
              <figcaption class="rxsz-explorer__caption" data-explorer-caption data-i18n="explorer.views.3.caption">{{ 'rxsz.health.explorer_views_3_caption' | t | escape }}</figcaption>
            </figure>
            <button class="rxsz-explorer__zoom" type="button" data-explorer-zoom hidden aria-label="{{ 'rxsz.health.explorer_zoom' | t | escape }}" data-i18n-attr="aria-label:explorer.zoom"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M9 4H4v5M15 4h5v5M20 15v5h-5M4 15v5h5"/></svg></button>
          </div>
          <div data-explorer-controls hidden>
            <div class="rxsz-explorer__toolbar"><p class="rxsz-explorer__hint" data-i18n="explorer.hint">{{ 'rxsz.health.explorer_hint' | t | escape }}</p><button type="button" class="rxsz-explorer__arrow" data-explorer-prev data-i18n-attr="aria-label:explorer.previous" aria-label="{{ 'rxsz.health.explorer_previous' | t | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 6l-6 6 6 6"/></svg></button><span class="rxsz-explorer__count" data-explorer-count aria-hidden="true">1 / 4</span><button type="button" class="rxsz-explorer__arrow" data-explorer-next data-i18n-attr="aria-label:explorer.next" aria-label="{{ 'rxsz.health.explorer_next' | t | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 6l6 6-6 6"/></svg></button></div>
            <div class="rxsz-explorer__picker" data-explorer-picker role="group" aria-label="{{ 'rxsz.health.explorer_picker_aria' | t | escape }}" data-i18n-attr="aria-label:explorer.picker_aria">
              <button type="button" class="rxsz-explorer__choice" data-explorer-select="0" aria-pressed="true" aria-controls="health-view-0"><img src="{{ 'rxsz-health-explorer-thumb-0.webp' | asset_url }}" width="160" height="133" alt="" loading="lazy" decoding="async"><span data-i18n="explorer.views.0.name">{{ 'rxsz.health.explorer_views_0_name' | t | escape }}</span></button>
              <button type="button" class="rxsz-explorer__choice" data-explorer-select="1" aria-pressed="false" aria-controls="health-view-1"><img src="{{ 'rxsz-health-explorer-thumb-1.webp' | asset_url }}" width="160" height="200" alt="" loading="lazy" decoding="async"><span data-i18n="explorer.views.1.name">{{ 'rxsz.health.explorer_views_1_name' | t | escape }}</span></button>
              <button type="button" class="rxsz-explorer__choice" data-explorer-select="2" aria-pressed="false" aria-controls="health-view-2"><img src="{{ 'rxsz-health-explorer-thumb-2.webp' | asset_url }}" width="160" height="133" alt="" loading="lazy" decoding="async"><span data-i18n="explorer.views.2.name">{{ 'rxsz.health.explorer_views_2_name' | t | escape }}</span></button>
              <button type="button" class="rxsz-explorer__choice" data-explorer-select="3" aria-pressed="false" aria-controls="health-view-3"><img src="{{ 'rxsz-health-explorer-thumb-3.webp' | asset_url }}" width="160" height="133" alt="" loading="lazy" decoding="async"><span data-i18n="explorer.views.3.name">{{ 'rxsz.health.explorer_views_3_name' | t | escape }}</span></button>
            </div>
          </div>
          <p class="rxsz-explorer__status rxsz-visually-hidden" data-explorer-status role="status" aria-live="polite" aria-atomic="true"></p>
          <dialog class="rxsz-explorer__dialog" data-explorer-dialog aria-labelledby="explorer-dialog-title">
            <div class="rxsz-explorer__dialog-head"><h2 id="explorer-dialog-title" data-explorer-dialog-title></h2><button type="button" class="rxsz-explorer__close" data-explorer-close aria-label="{{ 'rxsz.health.explorer_close' | t | escape }}" data-i18n-attr="aria-label:explorer.close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
            <div class="rxsz-explorer__zoom-media" data-explorer-zoom-media></div>
            <p class="rxsz-explorer__dialog-status" data-explorer-dialog-status role="status" aria-live="polite" aria-atomic="true"></p>
            <div class="rxsz-explorer__dialog-foot"><button type="button" class="rxsz-explorer__arrow" data-explorer-prev data-i18n-attr="aria-label:explorer.previous" aria-label="{{ 'rxsz.health.explorer_previous' | t | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 6l-6 6 6 6"/></svg></button><p class="rxsz-explorer__dialog-caption" data-explorer-dialog-caption></p><button type="button" class="rxsz-explorer__arrow" data-explorer-next data-i18n-attr="aria-label:explorer.next" aria-label="{{ 'rxsz.health.explorer_next' | t | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 6l6 6-6 6"/></svg></button></div>
          </dialog>
        </div></div></section>

    <section class="rxsz-auth-section rxsz-auth-section--frost" id="aspiration" data-editorial-side="left">
      <div class="rxsz-wrap rxsz-auth-split">
        <figure class="rxsz-auth-media rxsz-auth-media--square">
          <img src="{{ 'rxsz-health-aspiration-authentic.webp' | asset_url }}" alt="{{ 'rxsz.health.aspiration_image_alt' | t | escape }}" data-i18n-attr="alt:aspiration.image_alt" width="1200" height="1000" loading="lazy" decoding="async">
        </figure>
        <div>
          <p class="rxsz-auth-kicker" data-i18n="aspiration.kicker">{{ 'rxsz.health.aspiration_kicker' | t | escape }}</p>
          <h2 class="rxsz-auth-title" data-i18n="aspiration.title">{{ 'rxsz.health.aspiration_title' | t | escape }}</h2>
          <p class="rxsz-auth-copy" data-i18n="aspiration.copy">{{ 'rxsz.health.aspiration_copy' | t | escape }}</p>
          <a class="rxsz-text-link" href="#offer" data-purchase-action="scroll"><span data-i18n="aspiration.cta">{{ 'rxsz.health.aspiration_cta' | t | escape }}</span><span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="rxsz-auth-section rxsz-auth-section--blue" id="benefits">
      <div class="rxsz-wrap">
        <div class="rxsz-benefits__head">
          <p class="rxsz-auth-kicker" data-i18n="benefits.kicker">{{ 'rxsz.health.benefits_kicker' | t | escape }}</p>
          <h2 class="rxsz-auth-title" data-i18n="benefits.title">{{ 'rxsz.health.benefits_title' | t | escape }}</h2>
          <p class="rxsz-auth-copy" data-i18n="benefits.copy">{{ 'rxsz.health.benefits_copy' | t | escape }}</p>
        </div>
        <ul class="rxsz-benefits__grid">
          <li><h3 data-i18n="benefits.items.0.title">{{ 'rxsz.health.benefits_items_0_title' | t | escape }}</h3><p data-i18n="benefits.items.0.text">{{ 'rxsz.health.benefits_items_0_text' | t | escape }}</p></li>
          <li><h3 data-i18n="benefits.items.1.title">{{ 'rxsz.health.benefits_items_1_title' | t | escape }}</h3><p data-i18n="benefits.items.1.text">{{ 'rxsz.health.benefits_items_1_text' | t | escape }}</p></li>
          <li><h3 data-i18n="benefits.items.2.title">{{ 'rxsz.health.benefits_items_2_title' | t | escape }}</h3><p data-i18n="benefits.items.2.text">{{ 'rxsz.health.benefits_items_2_text' | t | escape }}</p></li>
          <li><h3 data-i18n="benefits.items.3.title">{{ 'rxsz.health.benefits_items_3_title' | t | escape }}</h3><p data-i18n="benefits.items.3.text">{{ 'rxsz.health.benefits_items_3_text' | t | escape }}</p></li>
        </ul>
        <a class="rxsz-btn rxsz-btn--ghost" href="#offer" data-purchase-action="scroll" data-i18n="purchase.intent">{{ 'rxsz.health.purchase_intent' | t | escape }}</a>
      </div>
    </section>

    <section class="rxsz-auth-section rxsz-auth-ritual" id="ritual">
      <div class="rxsz-wrap">
        <div class="rxsz-auth-ritual__head rxsz-reveal">
          <p class="rxsz-auth-kicker" data-i18n="ritual.kicker">{{ 'rxsz.health.ritual_kicker' | t | escape }}</p>
          <h2 class="rxsz-auth-title" data-i18n="ritual.title">{{ 'rxsz.health.ritual_title' | t | escape }}</h2>
          <p class="rxsz-auth-copy" data-i18n="ritual.copy">{{ 'rxsz.health.ritual_copy' | t | escape }}</p>
        </div>
        <div class="rxsz-steps__grid">
          <article class="rxsz-step rxsz-auth-step rxsz-reveal" data-editorial-side="left">
            <figure class="rxsz-step__media rxsz-auth-step__media">
              <img src="{{ 'rxsz-health-ritual-prepare-authentic.webp' | asset_url }}" width="1200" height="1000" loading="lazy" data-i18n-attr="alt:ritual.steps.0.img_alt" alt="{{ 'rxsz.health.ritual_steps_0_img_alt' | t | escape }}" decoding="async">
            </figure>
            <div class="rxsz-auth-step__body">
              <span class="rxsz-step__num rxsz-auth-step__num">01</span>
              <h3 data-i18n="ritual.steps.0.title">{{ 'rxsz.health.ritual_steps_0_title' | t | escape }}</h3>
              <p data-i18n="ritual.steps.0.text">{{ 'rxsz.health.ritual_steps_0_text' | t | escape }}</p>
            </div>
          </article>
          <article class="rxsz-step rxsz-auth-step rxsz-reveal" data-editorial-side="right">
            <figure class="rxsz-step__media rxsz-auth-step__media">
              <img src="{{ 'rxsz-health-ritual-breathe-authentic.webp' | asset_url }}" width="1200" height="1000" loading="lazy" data-i18n-attr="alt:ritual.steps.1.img_alt" alt="{{ 'rxsz.health.ritual_steps_1_img_alt' | t | escape }}" decoding="async">
            </figure>
            <div class="rxsz-auth-step__body">
              <span class="rxsz-step__num rxsz-auth-step__num">02</span>
              <h3 data-i18n="ritual.steps.1.title">{{ 'rxsz.health.ritual_steps_1_title' | t | escape }}</h3>
              <p data-i18n="ritual.steps.1.text">{{ 'rxsz.health.ritual_steps_1_text' | t | escape }}</p>
            </div>
          </article>
          <article class="rxsz-step rxsz-auth-step rxsz-reveal" data-editorial-side="left">
            <figure class="rxsz-step__media rxsz-auth-step__media">
              <img src="{{ 'rxsz-health-ritual-store-authentic.webp' | asset_url }}" width="1200" height="1000" loading="lazy" data-i18n-attr="alt:ritual.steps.2.img_alt" alt="{{ 'rxsz.health.ritual_steps_2_img_alt' | t | escape }}" decoding="async">
            </figure>
            <div class="rxsz-auth-step__body">
              <span class="rxsz-step__num rxsz-auth-step__num">03</span>
              <h3 data-i18n="ritual.steps.2.title">{{ 'rxsz.health.ritual_steps_2_title' | t | escape }}</h3>
              <p data-i18n="ritual.steps.2.text">{{ 'rxsz.health.ritual_steps_2_text' | t | escape }}</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="rxsz-auth-section rxsz-auth-section--frost" id="product" data-editorial-side="right">
      <div class="rxsz-wrap rxsz-auth-product">
        <figure class="rxsz-auth-media rxsz-auth-media--square rxsz-reveal">
          <img src="{{ 'rxsz-health-product-authentic.webp' | asset_url }}" width="1200" height="1000" loading="lazy" data-i18n-attr="alt:product.img_alt" alt="{{ 'rxsz.health.product_img_alt' | t | escape }}" decoding="async">
        </figure>
        <div class="rxsz-reveal">
          <p class="rxsz-auth-kicker" data-i18n="product.kicker">{{ 'rxsz.health.product_kicker' | t | escape }}</p>
          <h2 class="rxsz-auth-title" data-i18n="product.title">{{ 'rxsz.health.product_title' | t | escape }}</h2>
          <p class="rxsz-auth-copy" data-i18n="product.copy">{{ 'rxsz.health.product_copy' | t | escape }}</p>
          <div class="rxsz-product-includes">
            <h3 data-i18n="product.included_title">{{ 'rxsz.health.product_included_title' | t | escape }}</h3>
            <ul>
              <li><span class="rxsz-ico" data-icon="fold" aria-hidden="true"></span><div><h4 data-i18n="product.includes.0.title">{{ 'rxsz.health.product_includes_0_title' | t | escape }}</h4><p data-i18n="product.includes.0.text">{{ 'rxsz.health.product_includes_0_text' | t | escape }}</p></div></li>
              <li><span class="rxsz-ico" data-icon="breathe" aria-hidden="true"></span><div><h4 data-i18n="product.includes.1.title">{{ 'rxsz.health.product_includes_1_title' | t | escape }}</h4><p data-i18n="product.includes.1.text">{{ 'rxsz.health.product_includes_1_text' | t | escape }}</p></div></li>
            </ul>
          </div>
